# ~/.config/pnpm/auth.ini: the GitHub Packages token helpers (read:packages)
# for pnpm and mise; npm ignores this file. Generated, because the helpers
# must be absolute paths without arguments (mise ignores any other form) and
# $HOME differs between the Mac and the devbox. A scoped entry wins over the
# default; add scopes here. Written only when its content changes.
if test -d ~/.config/pnpm
    set -l helpers ~/.config/pnpm/token-helpers
    set -l content \
        "# Generated by fish conf.d/37-pnpm-auth.fish; edit it there." \
        "//npm.pkg.github.com/:tokenHelper=$helpers/default" \
        "//npm.pkg.github.com/:@asg-song:tokenHelper=$helpers/ASG-SONG"
    set -l file ~/.config/pnpm/auth.ini
    set -l current
    test -f $file; and set current (string collect <$file)
    if test "$current" != "$(string join \n $content)"
        printf '%s\n' $content >$file
    end
end
