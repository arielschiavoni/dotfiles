{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/gpt-6-luna",
  "default_agent": "build",
  "update": "disable",
  "permissions": [{ "action": "context7*", "resource": "*", "effect": "deny" }],
  "agents": {
    "plan": {
      "model": "github-copilot/gpt-6-luna",
      "permissions": [
        { "action": "context7*", "resource": "*", "effect": "allow" }
      ]
    },
    "build": {
      "model": "github-copilot/gpt-6-luna"
    },
    "explore": {
      "model": "github-copilot/gpt-6-luna"
    }
  },
  "experimental": {
    "policies": [
      { "action": "provider.use", "resource": "*", "effect": "deny" },
      {
        "action": "provider.use",
        "resource": "github-copilot",
        "effect": "allow"
      }
    ]
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "disabled": false
      }
    }
  }
}
