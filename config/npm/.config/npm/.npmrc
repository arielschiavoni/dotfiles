//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
# pnpm-only: per-scope token on the same host, so @asg-song packages resolve
# with the ASG-SONG token from any repo (npm ignores this key).
//npm.pkg.github.com/:@asg-song:_authToken=${GITHUB_TOKEN_ASG_SONG}
progress=true
audit=false
loglevel=info
@asg-song:registry=https://npm.pkg.github.com
