[init]
        defaultBranch = main
[core]
        excludesfile = ~/.config/git/.gitignore_global
        editor = nvim
        pager = hunk pager
        hooksPath = no-hooks
        fsmonitor = false
        untrackedcache = false
[user]
        name = Ariel Schiavoni
        email = arielschiavoni@gmail.com
[github]
        user = arielschiavoni
[color]
        ui = true
[push]
        default = simple
[credential]
        helper = cache --timeout=36000000
[pull]
        rebase = true
[fetch]
        prune = true
[merge]
        conflictstyle = zdiff3
[diff]
        colorMoved = default
        algorithm = histogram
[rebase]
        autoStash = true
[rerere]
        enabled = true
[url "https://github.com/"]
        insteadOf = git@github.com:
[includeIf "gitdir:~/repos/oneaudi/"]
        path = "~/.config/git/work_config"
[includeIf "gitdir:~/repos/volkswagen-onehub/"]
        path = "~/.config/git/work_config"
[includeIf "gitdir:~/repos/accenture-song-naip/"]
        path = "~/.config/git/work_config"
